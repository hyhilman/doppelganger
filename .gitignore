# No trailing slash: a nightly pass symlinks node_modules into its worktree,
# and `node_modules/` matches only a real directory, never a symlink.
node_modules
dist/
*.db
*.db-wal
*.db-shm
.env
.doppelganger/
.sandcastle/

# Build scaffolding, deliberately untracked (2026-08-27). The behaviour these
# specified now lives in tests; the drift gates that read them degrade to a
# reported skip when absent, on the CORPUS_RECHECK precedent.
plan/
roadmap.md
WORK.md
LOOP.md

# Agent git worktrees: full second checkouts, never this repo's source.
.claude/worktrees/
