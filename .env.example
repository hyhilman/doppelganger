# doppelganger — every knob, one row per EnvSpec (KRN-06).
#
# Copy this file to `.env` and edit it. `.env` is gitignored; this file is not.
#
# HOW TO READ A ROW. The comment above each key is the row's own `why` — the knob doc lives
# beside the knob in code (KRN-06), and this file copies it rather than writing a second one.
# A key that is COMMENTED OUT shows its built-in default; uncomment it only to change it.
# A key that is NOT commented out is REQUIRED and has no default — the process throws without it.
# A key with `<...>` in its name is a FAMILY: substitute the real name and uncomment.
#
# NOTHING LOADS THIS FILE AUTOMATICALLY. There is no dotenv dependency (TST-22 — no libraries
# this repo can do without). Source it into the environment that starts the loop:
#   bare metal   `set -a; . ./.env; set +a` before `npm run crontab sync`
#   container    `fleet/compose.yml` reads it via `env_file:`
#
# `test/knobs.test.ts` assertion 8 holds this file to the code: a knob added without a row here
# fails the build, and so does a row whose default or `why` has drifted from the source.

# --- kernel/instance.ts ---

# names this checkout; discriminates every host-global write (INS-01)
# INSTANCE=

# --- kernel/paths.ts ---

# the checkout every project-relative write resolves inside (INS-02)
# ENGINE_ROOT=

# where every integration's database lives, resolved inside the checkout (DBS-01, INS-02)
# ENGINE_STATE_DIR=.doppelganger/state

# redirect one integration's database to a throwaway file for a safe run (DBS-07, SAF-05)
# <NAME>_DB=

# --- kernel/ports/runner.ts ---

# wall-clock bound on ONE agent run, aborted rather than the supervisor's child (SUP-13 is that bound); unread at N3, since the only job is taskClass: impl
# RUN_TIMEOUT_MS=1500000

# the ceiling for a taskClass: impl run — a build-and-verify pass, not a read (HRN-13)
# RUN_TIMEOUT_IMPL_MS=2400000

# --- kernel/runtime/db.ts ---

# how long a statement waits on a held write lock; deliberately unchanged while the cause is unknown (DBS-04)
# SQLITE_BUSY_TIMEOUT_MS=5000

# --- kernel/runtime/gate.ts ---

# consecutive lock-held skips before a job counts as starved at the gate (GAT-10)
# LOCK_STARVE_N=6

# raise the starve threshold for one job whose cadence makes 6 skips normal (GAT-10)
# LOCK_STARVE_N_<JOB>=

# --- kernel/runtime/log/ ---

# below this level a line is dropped by BOTH emitters (LOG-10)
# LOG_LEVEL=info

# rotate a log above this; ~4x normal traffic, so it fires on a runaway job (LOG-08)
# LOG_MAX_BYTES=8388608

# cap on what one tick reads from one file, so a runaway cannot pull itself into memory before rotation bounds it (LOG-08)
# LOG_MAX_READ_BYTES=4194304

# --- kernel/runtime/exec.ts ---

# wall-clock bound on ONE gh/git call; an unbounded stalled gh blocks the event loop so lease heartbeats stop (HRN-19)
# EXEC_TIMEOUT_MS=180000

# --- kernel/runtime/quota.ts, shed.ts ---

# the host/factory account scope every standalone job shares (QTA-01) — one switch, so whichever job discovers the limit parks the rest
# QUOTA_SCOPE=claude

# the base re-probe window; every class scales it by a multiple (QTA-06), read per call
# QUOTA_PAUSE_MS=1800000

# pin one class's window in ms directly, when its cadence should not move with the others (QTA-06)
# QUOTA_PAUSE_MS_<CLASS>=

# how long after a window expires a fresh park still belongs to the SAME outage (QTA-07) — the floor is the class's own window
# QUOTA_DARK_GAP_MS=7200000

# how long after a spend wall opens a chore/watch job still sheds load for it (QTA-08), read per call like every other quota knob
# QUOTA_SHED_WINDOW_MS=86400000

# --- host/cron.ts, host/supervisor.ts ---

# longest a gate writer may block — a job whose own tick is rarer than this waits the cap, not its interval (GAT-08)
# GATE_WAIT_CAP_S=1800

# the runtime bound for one entry's child (SUP-13) — already in §2.27; 1.5x the longest legitimate pass
# SUPERVISOR_MAX_RUN_MIN=180

# SIGTERM -> this -> SIGKILL; the window to flush a stack trace, not to finish
# SUPERVISOR_KILL_GRACE_MS=10000

# the cross-entry half of HRN-18's ~/.gitconfig start-up race
# SUPERVISOR_SPAWN_STAGGER_MS=2000

# how long a child gets to exit on shutdown before it is killed; a process manager's own stop timeout must exceed it
# SUPERVISOR_DRAIN_MS=30000

# --- host/config.ts (the watchdog reads these from bash; host/notify.ts also reads the NTFY_* three) ---

# how many missed 60s supervisor heartbeats (SUP-14) count as a dead scheduler; read by host/watchdog.sh, never by TypeScript
# WATCHDOG_SUPERVISOR_STALE_M=5

# the watchdog logs and prints its faults, writes no breach file and exits 0 (SAF-01, for a tool)
# WATCHDOG_DRY_RUN=0

# base URL of the ntfy server the watchdog POSTs a breach to and the log report (JOB-O02) POSTs its report to; unset in BOTH the environment and .env means no send at all — a real default would be a guess about someone else's host, the same reason CRONTAB_CMD has none
# NTFY_URL=

# the ntfy topic a watchdog breach and a log report land on; defaults to INSTANCE (the checkout's own directory name), so two checkouts on one host never share an alarm channel (INS-01)
# NTFY_TOPIC=

# bearer token for NTFY_URL, used by the watchdog and the log report, read from the environment or from .env; unset in both means no send at all — an ntfy server that denies anonymous publish turns a missing token into a silent 403 rather than a delivered alarm
# NTFY_TOKEN=

# KRN-07 kill switch: faults are still logged and still written to the breach file, only the POST is skipped — for someone working on the alarm path who must not page themselves
# WATCHDOG_NO_NOTIFY=0

# --- cli/ ---

# the crontab binary this tool calls; must be absolute (layer 0) — a bare name is a PATH lookup. NO default on purpose (F1): a real, absolute default is itself a real crontab binary, so a caller who forgets to set this must throw, not silently read the developer's own crontab
CRONTAB_CMD=/usr/bin/crontab

# sync prints the crontab it would install and calls nothing (SAF-01); it still reads, since the read is what makes the printed diff true
# CRONTAB_DRY_RUN=0

# sync prints the plan it would execute and writes nothing (SAF-01); still reads, since the read is what makes the printed plan true
# SKILLS_DRY_RUN=0

# prints what it would delete and calls nothing (SAF-01, for a tool)
# LEASE_CLEAR_DRY_RUN=0

# --- plugins/nightly/jobs/nightly-sandcastle.ts (the safe-run surface, SAF-01…07) ---

# KRN-07 kill switch: the pass logs killed and returns before reading anything
# NIGHTLY_NO_SANDCASTLE=0

# the branch a pass lands on; a checkout on any other branch refuses (not-on-base)
# NIGHTLY_SANDCASTLE_BASE=main

# SAF-01: run the agent and the gate for real, write nothing — no commit, no merge, no state. This dry run COSTS one agent pass (SAF-07); *_MAX=0 is the free one
# NIGHTLY_SANDCASTLE_DRY_RUN=0

# SAF-02 shadow mode: commit inside the worktree, never move the base branch
# NIGHTLY_SANDCASTLE_NO_MERGE=0

# SAF-03/04: passes per tick. 0 is the free smoke test — everything but the agent — and it is free
# NIGHTLY_SANDCASTLE_MAX=1

# SAF-06: force one goal key instead of the rotation, for debugging one brief end to end
# NIGHTLY_SANDCASTLE_ONLY=

# override the model tier one pass spends on without a code change; the value is checked against PINNED at the one place RunRequest.model is built (HRN-11)
# NIGHTLY_SANDCASTLE_MODEL=

# --- plugins/nightly/jobs/nightly-polish.ts (the safe-run surface, SAF-01…07) ---

# KRN-07 kill switch: the polish pass logs killed and returns before reading anything
# NIGHTLY_NO_POLISH=0

# the branch a polish pass lands on; a checkout on any other branch skips (not-on-base)
# NIGHTLY_POLISH_BASE=main

# SAF-01: run the agent and the doc gate for real, write nothing — no commit, no merge, no state, no issue. Costs one agent pass (SAF-07); *_MAX=0 is the free one
# NIGHTLY_POLISH_DRY_RUN=0

# SAF-02 shadow mode: commit inside the worktree, never move the base branch
# NIGHTLY_POLISH_NO_MERGE=0

# SAF-03/04: 1 runs one real pass per tick. 0 is the free smoke test — everything but the agent
# NIGHTLY_POLISH_MAX=1

# SAF-06: force one goal key instead of the rotation, to debug one brief end to end
# NIGHTLY_POLISH_ONLY=

# override the model one polish pass spends on without a code change; runJob checks it is pinned (HRN-11)
# NIGHTLY_POLISH_MODEL=

# owner/repo that gets one issue per pass, created and closed in the same pass. Unset (the default) means no issue and no gh call
# NIGHTLY_POLISH_TRACKER=

# --- plugins/git/scope.ts (which repos and branches the git jobs touch, JOB-G04/05) ---

# project-relative repo directories the git jobs sweep, space- or comma-separated; explicit, never globbed, empty means do nothing (JOB-G04)
# RESET_REPOS=

# long-lived branches reset-branches syncs to origin, tried in every repo; a name the remote lacks is skipped (JOB-G05)
# RESET_BRANCHES=main staging development dev

# branches that get their own read-only worktree; a subset of RESET_BRANCHES, never main or master (JOB-G07)
# ENV_WORKTREE_BRANCHES=staging development dev

# repos whose env branches reset-env-to-main force back to main on origin; a subset of RESET_REPOS, empty means do nothing (JOB-G09)
# RECUT_REPOS=

# env branches reset-env-to-main re-cuts from main; a subset of RESET_BRANCHES, never main or master (JOB-G11)
# RECUT_BRANCHES=staging development

# project-relative directory for the env and PR-head worktrees; kept under a gitignored path so a tree there never dirties the checkout (INS-02)
# GIT_WORKTREE_DIR=.doppelganger/worktree

# --- plugins/git/jobs/ops-reset-branches.ts (JOB-G01…03) ---

# 1 lets reset-branches reset a dirty checked-out tree (the changes are lost) and switch a dirty parked checkout (JOB-G02)
# RESET_FORCE_DIRTY=0

# 1 lets reset-branches discard YOUR commits that are not on origin; they are lost (JOB-G02)
# RESET_FORCE_AHEAD=0

# 1 moves a clean primary checkout parked on a feature branch back to main; 0 only warns (JOB-G03)
# RESET_CHECKOUT_MAIN=1

# 1 still fetches but writes no ref, resets no tree and switches no checkout (SAF-01)
# RESET_DRY_RUN=0

# 1 runs ensure-env-worktrees quietly before the sync, so every env branch has a tree to reset (JOB-G07)
# RESET_ENSURE_WORKTREES=1

# --- plugins/git/jobs/ops-ensure-env-worktrees.ts (JOB-G07) ---

# 1 prints what ensure-env-worktrees would create and writes nothing, not even the worktree directory (SAF-01)
# ENV_WORKTREE_DRY_RUN=0

# 1 drops the banner, the already-there lines and an empty done line, so a clean run prints nothing (JOB-G07)
# ENV_WORKTREE_QUIET=0

# --- plugins/git/jobs/ops-reset-env-to-main.ts (JOB-G09…12) ---

# KRN-07 kill switch: 1 stops reset-env-to-main before it fetches or pushes anything; the weekly re-cut of env branches is skipped (JOB-G09)
# GIT_NO_RECUT=0

# 1 still fetches and prints each backup and re-cut it would push, and pushes nothing (SAF-01)
# RECUT_DRY_RUN=0

# 1 re-cuts even when today's backup exists at another commit, saving the new head as a second backup beside it (JOB-G10)
# RECUT_FORCE=0

# YYYY-MM-DD stamp in the backup branch name; empty means today in UTC (JOB-G10)
# RECUT_DATE=

# --- plugins/ops/jobs/ops-log-report.ts (reads NTFY_URL/NTFY_TOPIC/NTFY_TOKEN above for its POST) ---

# minutes before the same job/event fault is posted again; a new fault is never delayed (JOB-O02)
# LOG_REPORT_COOLDOWN_M=30

# fault keys shown in one report; the rest become one '…and N more' line (JOB-O02)
# LOG_REPORT_MAX_KEYS=8

# 1 = print the report to stdout; post nothing, stamp nothing, move no log cursor (SAF-01)
# LOG_REPORT_DRY_RUN=0

# --- plugins/ops/jobs/ops-retention.ts ---

# done/failed leases older than this are deleted; long, since deleting a done lease frees its key again (JOB-O06)
# RETENTION_LEASE_DAYS=60

# 1 = count every row the sweep would delete; delete nothing and skip the WAL checkpoint (SAF-01)
# RETENTION_DRY_RUN=0
